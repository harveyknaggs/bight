# Copy this file to .env.local and fill in the real values from your Supabase project.
# Settings > API in the Supabase dashboard.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me-with-anon-key

# Server-side only. Never expose this to the browser. Used for the lead import job.
SUPABASE_SERVICE_ROLE_KEY=replace-me-with-service-role-key

# Path to the scraper output on disk. Used by the /sync-leads import.
# On Windows, use forward slashes or escape backslashes.
SCRAPER_NICHES_DIR=D:/website project/projects/lead-gen-pipeline/niches

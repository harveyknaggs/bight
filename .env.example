# Copy this file to .env.local and fill in real values.

# ---- Database (Railway Postgres) ----
# Public URL from the Postgres service Variables tab (host ends in .proxy.rlwy.net).
DATABASE_URL=postgresql://postgres:password@host.proxy.rlwy.net:port/railway

# ---- Auth.js ----
# Random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=replace-me-with-random-string

# Email addresses (comma-separated) that should be promoted to staff role on first sign-in.
STAFF_EMAILS=hello@rapidrefresh.co

# ---- Resend (magic-link emails) ----
AUTH_RESEND_KEY=re_your_resend_api_key
EMAIL_FROM=Rapid Refresh <login@rapidrefresh.co>

# ---- Scraper sync ----
# Path on disk where the scraper writes per-lead folders.
# On Windows use forward slashes.
SCRAPER_NICHES_DIR=D:/website project/projects/lead-gen-pipeline/niches
